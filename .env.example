# Supabase (conta do Leonardo — multi-tenant)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # usada só pelos jobs/backend (ignora RLS)

# Asaas (por tenant na config; aqui só fallback/sandbox de dev)
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# E-mail transacional (plugar no go-live; remetente real por tenant)
EMAIL_PROVIDER_API_KEY=

# NFS-e Padrão Nacional (certificado A1 por tenant — referência no cofre)
NFSE_AMBIENTE=homologacao
